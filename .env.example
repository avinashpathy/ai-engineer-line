# Copy to .env.local for local development. Never commit real values.
# Both Supabase values are designed to be public (Row Level Security protects the data).
# Leave them empty to run the site with sign-in turned off.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase calls this the "anon" key on older projects and the "publishable" key on newer ones.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Your live site address, used for link previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Optional extra sign-in buttons. Leave empty for email-link sign-in only.
# Only list a provider after setting it up in Supabase (DEPLOY.md, step 2), or its button will fail.
NEXT_PUBLIC_AUTH_PROVIDERS=
# NEVER add the service_role / secret key to this app.
