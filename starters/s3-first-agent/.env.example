# Copy this file to .env and pick ONE provider.
# Ollama on your own computer (free): install from ollama.com, then run:  ollama pull llama3.2   (a model that supports tool calling)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Or a hosted provider with an OpenAI-compatible API, for example Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL=a-model-name-from-their-model-list
